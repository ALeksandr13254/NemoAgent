# ---- NemoAgent server configuration (copy to server/.env) ----

# Shared secret: the client must present the same value. Generate any long random string.
AGENT_TOKEN=change-me-to-a-long-random-string

# Listen address. 0.0.0.0 makes the server reachable from other machines.
HOST=0.0.0.0
PORT=8700

# NVIDIA NIM (build.nvidia.com). Server-side defaults per role — the client overrides them from its settings:
# LLM_MODEL = dialogue agent + executor, ROUTER_MODEL = the request classifier (Nano Omni by default: every role sees
# images, audio and video itself; Nemotron 3.5 Super VL 120B, GLM 5.3 Flash, Step 5 Preview and DeepSeek V4.1 Flash
# are also multimodal — text and images only — and can be picked per role).
# TEXT_ONLY_MODELS: models that get a text note instead of media (Lightning, GLM 5.3).
NVIDIA_API_KEY=nvapi-...
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
ROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Reasoning effort for the dialogue agent and the executor, off | low | high | max (the client picks it per
# session in its settings panel; this is the default). Nemotron only switches thinking on/off, GLM budgets it
# with reasoning_effort, DeepSeek with a numeric reasoning_effort 1-100 (off/low/high/max = 1/33/66/100);
# StepFun has no documented NIM switch and follows the on/off path. Answers are not capped in length: no
# max_tokens is sent. Router and video probe are internal short calls and keep their own small caps.
LLM_REASONING=off
LLM_TEMPERATURE=0.3

# Requests to the free NIM pool (README, section 3.5): a failed one is retried at once.
# NIM_RETRY_DELAYS lists pauses before successive retries in seconds (the last repeats), e.g. 0.3,0.6,1,2.
NIM_RETRY_DELAYS=0
NIM_RETRY_BUDGET_S=30
# A 429 (the key's per-minute limit) makes every request wait: Retry-After, or these pauses for successive 429s.
NIM_RATE_LIMIT_DELAYS=5,10,20,30
NIM_RATE_LIMIT_MAX_WAIT_S=120
# One embeddings/rerank attempt waits EMBED_ATTEMPT_TIMEOUT_S for the pool, then it is cancelled
# and retried at once; 429 rate-limit waits are unaffected.
EMBED_ATTEMPT_TIMEOUT_S=60
# A failed embeddings/rerank request (5xx, stall, dropped connection) is retried up to EMBED_MAX_ATTEMPTS times
# within NIM_RETRY_BUDGET_S. Models whose batches the pool fails get one input per request, EMBED_CONCURRENCY at
# a time: nemotron-3.5-embed-8b answers 500 to most batches of 3+ texts and to every request with 2+ images.
EMBED_MAX_ATTEMPTS=8
EMBED_SINGLE_INPUT_MODELS=nvidia/nemotron-3.5-embed-8b
EMBED_CONCURRENCY=4
# NIM host unreachable (no network): retry every NIM_CONNECT_RETRY_DELAY_S seconds.
NIM_CONNECT_RETRY_DELAY_S=0.5
EMBED_TEXT_MODEL=nvidia/nemotron-3-embed-1b
EMBED_VL_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# Multimodal text+image embeddings in one space (the UI's "Эмбеддинги" tab compares texts and pictures through it).
EMBED_MM8B_MODEL=nvidia/nemotron-3.5-embed-8b
# Cross-encoder reranking for the UI's "Эмбеддинги" tab (query -> passages relevance logits).
# integrate.api.nvidia.com does not serve it; the sanctioned host is ai.api.nvidia.com (same NVIDIA_API_KEY).
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
RERANK_BASE_URL=https://ai.api.nvidia.com/v1/

# Attachments go straight into the model. ffmpeg (on PATH or a full path here) converts any audio/video
# to what the model takes (mp3 / mp4 <= 2 min); without it only wav, mp3 and mp4 files are sent as they are.
FFMPEG=ffmpeg
MEDIA_IMAGE_MAX_SIDE=1600
MEDIA_AUDIO_MAX_S=1200
MEDIA_VIDEO_MAX_S=120
MEDIA_KEEP_TURNS=2

# Live context budget (older turns drop out of the model context; the client keeps them in its memory)
CONTEXT_BUDGET_TOKENS=60000
CONTEXT_KEEP_TURNS=6

# web_search: a search API key makes results real (free tiers exist); without one the tool falls back to
# Bing's RSS feed, which is weak for Russian queries. The first configured key is used.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# optional proxy for web_search / fetch_page, e.g. http://127.0.0.1:2080
WEB_PROXY=

# The server keeps nothing on disk: uploads live in RAM only while a client uses them (seconds since last use)
UPLOAD_MAX_MB=100
UPLOAD_TTL_S=7200
LOG_LEVEL=info
