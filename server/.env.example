# ---- NemoAgent server configuration (copy to server/.env) ----

# Shared secret: the client must present the same value. Generate any long random string.
AGENT_TOKEN=change-me-to-a-long-random-string

# Listen address. 0.0.0.0 makes the server reachable from other machines.
HOST=0.0.0.0
PORT=8700

# NVIDIA NIM (build.nvidia.com) — the agent LLM and both embedding models run here.
NVIDIA_API_KEY=nvapi-...
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_THINKING=false
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=4096
EMBED_TEXT_MODEL=nvidia/nemotron-3-embed-1b
EMBED_VL_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Long-term memory (RAG over past dialogs)
MEMORY_AUTO_RECALL=true
MEMORY_TOP_K=4
MEMORY_MIN_SCORE=0.42
CONTEXT_BUDGET_TOKENS=60000
CONTEXT_KEEP_TURNS=6

# DeepSeek reverse API (vision, documents, web search).
#   DEEPSEEK_AUTH_TOKEN  = localStorage.userToken on chat.deepseek.com
#   server/deepseek_cookies.json = {"cf_clearance": "...", "aws-waf-token": "...", "ds_session_id": "..."}
DEEPSEEK_AUTH_TOKEN=
DEEPSEEK_COOKIES_FILE=deepseek_cookies.json
DEEPSEEK_TIMEZONE_OFFSET=10800
# Proxy for chat.deepseek.com only (leave empty for direct connection)
DEEPSEEK_PROXY=
DEEPSEEK_THINKING=false

UPLOAD_MAX_MB=100
LOG_LEVEL=info
