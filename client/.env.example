# ---- NemoAgent client configuration (copy to client/.env) ----

# Agent server address and the shared secret from server/.env
SERVER_URL=http://127.0.0.1:8700
AGENT_TOKEN=change-me-to-a-long-random-string

# Local web UI
UI_HOST=127.0.0.1
UI_PORT=8765
OPEN_BROWSER=true

# Speech recognition (faster-whisper). Model is downloaded to the HF cache on first start (~1.6 GB).
STT_ENABLED=true
STT_MODEL=large-v3-turbo
STT_DEVICE=auto
STT_COMPUTE=auto
STT_LANGUAGE=ru           # ru | en | auto
STT_BEAM=3

# Microphone / voice activity detection
# MIC_DEVICE=            # device name or index (python -m sounddevice to list)
AUTO_LISTEN=true
VAD_THRESHOLD=0.55
VAD_SILENCE_MS=750
VAD_MIN_SPEECH_MS=250
BARGE_IN=true
BARGE_IN_MIN_SPEECH_MS=450

# Text to speech (TeraTTSv2). Download with: python download_models.py
TTS_ENABLED=true
TTS_MODEL_DIR=models/TeraTTSv2
TTS_PROVIDER=auto        # auto | cuda | cpu
TTS_VOICE_RU=ru_f1       # ru_f1 ru_m5 ru_f2 ru_m1
TTS_VOICE_EN=eng_f5      # eng_f3 eng_f5 eng_m3 eng_m4 eng_f4_whisper eng_m2_whisper
TTS_LANGUAGE=ru           # auto (by sentence) | ru (everything in Russian) | en
TTS_SPEED=1.0            # duration scale: <1 faster, >1 slower
# SPEAKER_DEVICE=

# Models per role: Nano Omni everywhere by default (it sees attachments itself); Nemotron 3.5 Super VL 120B,
# GLM 5.3 Flash, Step 5 Preview and DeepSeek V4.1 Flash are also multimodal (text and images, no audio/video),
# Nemotron 3.5 Lightning 30B and GLM 5.3 are text only.
MODEL_DIALOGUE=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_EXECUTOR=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_ROUTER=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Reasoning effort for the dialogue agent and the executor, off | low | high | max (the settings panel
# overrides it per session). Nemotron only switches thinking on/off, GLM budgets it with reasoning_effort,
# DeepSeek with a numeric reasoning_effort 1-100 (off/low/high/max = 1/33/66/100); StepFun has no documented
# NIM switch and follows the on/off path. Answers are not capped in length. The router always classifies without reasoning.
REASONING=off

# Everything persistent lives on the client: chats, attachments, long-term memory, settings, prompt edits.
# CLIENT_DATA_DIR=client/data
MEMORY_TOP_K=4           # memories mixed into a message while the memory button is on
# Cosine threshold for that. Query -> memory cosines of these models are low (a relevant one 0.27-0.7, an unrelated
# one rarely above 0.24): 0.5 dropped 85-90% of the relevant memories.
MEMORY_MIN_SCORE=0.27
ATTACHMENT_KEEP_HOURS=1  # uploads that never made it into a chat are deleted after this

# Computer control
TOOLS_ENABLED=true
TOOL_CONFIRM=dangerous   # never | dangerous | always
TOOL_CONFIRM_TIMEOUT=90
SCREENSHOT_MAX_SIDE=1600 # 0 = full resolution
# SCREENSHOT_MONITORS=1,2  # monitors the screenshot button / look_at_screen capture (one image each); empty = all

LOG_LEVEL=info
